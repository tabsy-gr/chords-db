{
  "name": "@tabsy-gr/chords-db",
  "version": "0.6.0",
  "description": "A validated database of string-instrument and piano chord voicings. Hard fork of tombatossals/chords-db.",
  "license": "MIT",
  "author": "Tabsy",
  "contributors": [
    "David Rubert <david.rubert@gmail.com> (original author, tombatossals/chords-db)"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "lib"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./lib/*.json": "./lib/*.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run build:data && tsup",
    "build:data": "tsx scripts/generate.ts json",
    "stdout": "tsx scripts/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run build",
    "authors": "tsx scripts/generate-authors.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabsy-gr/chords-db.git"
  },
  "bugs": {
    "url": "https://github.com/tabsy-gr/chords-db/issues"
  },
  "homepage": "https://github.com/tabsy-gr/chords-db#readme",
  "keywords": [
    "chords",
    "guitar",
    "ukulele",
    "piano",
    "bouzouki",
    "music"
  ]
}
