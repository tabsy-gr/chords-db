{
  "name": "@tabsy-gr/chords-db",
  "version": "0.8.0",
  "description": "A validated database of string-instrument and piano chord voicings. Hard fork of tombatossals/chords-db.",
  "license": "MIT",
  "author": "Tabsy",
  "contributors": [
    "David Rubert <david.rubert@gmail.com> (original author, tombatossals/chords-db)"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "lib",
    "schema"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./guitar": "./lib/guitar.json",
    "./ukulele": "./lib/ukulele.json",
    "./ukulele-d": "./lib/ukulele-d.json",
    "./piano": "./lib/piano.json",
    "./cavaquinho": "./lib/cavaquinho.json",
    "./instruments": "./lib/instruments.json",
    "./schema/*": "./schema/*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npm run build:data && tsup",
    "build:data": "tsx scripts/build-data.ts",
    "format:data": "tsx scripts/format-data.ts",
    "check:format": "tsx scripts/format-data.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "authors": "tsx scripts/generate-authors.ts",
    "prepublishOnly": "npm run build",
    "validate": "tsx scripts/validate-data.ts",
    "upstream-diff": "tsx scripts/upstream-diff.ts",
    "generate:piano": "tsx scripts/generate-piano.ts",
    "generate:ukulele-d": "tsx scripts/generate-ukulele-d.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tonal": "^6.4.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabsy-gr/chords-db.git"
  },
  "bugs": {
    "url": "https://github.com/tabsy-gr/chords-db/issues"
  },
  "homepage": "https://github.com/tabsy-gr/chords-db#readme",
  "keywords": [
    "chords",
    "guitar",
    "ukulele",
    "piano",
    "bouzouki",
    "music"
  ],
  "type": "module"
}
